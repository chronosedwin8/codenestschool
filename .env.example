# ─── Base de datos (Docker postgres:15 en el puerto 5433) ────────────────────
DATABASE_URL="postgresql://codenest:codenest@localhost:5433/codenest_db"
SHADOW_DATABASE_URL="postgresql://codenest:codenest@localhost:5433/codenest_shadow"

# ─── Servidor ────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
TZ=America/Bogota
PUBLIC_BASE_URL=http://localhost:3001

# ─── Autenticacion (OBLIGATORIO en produccion: sin valor por defecto) ────────
JWT_SECRET=""
JWT_EXPIRES_IN=7d

# ─── ElevenLabs (solo para los scripts offline de generacion de voz) ─────────
# NUNCA se hardcodea en el codigo. Rotar si se filtra.
ELEVENLABS_API_KEY=""

# ─── Mercado Pago (pasarela de pago) ─────────────────────────────────────────
MP_ACCESS_TOKEN=""
MP_PUBLIC_KEY=""
MP_WEBHOOK_SECRET=""

# ─── Precios de los planes en pesos colombianos (el servidor decide, nunca el cliente) ──
PRECIO_PERSONAL_COP=180000
PRECIO_PADRES_COP=480000
PRECIO_ESCUELA_COP=12000000

# Cifra la copia recuperable del PIN de los estudiantes. Solo hace falta en colegios.
PIN_SECRET=

# Phidias: sistema academico del colegio. Sin esto, la importacion queda oculta.
PHIDIAS_BASE_URL=https://ds-barranquilla.phidias.co/rest
PHIDIAS_TOKEN=

# ─── Entra ID: entrar con la cuenta del colegio (Microsoft 365) ──────────────
# Los tres juntos activan el boton; si falta uno, no aparece y se entra con
# contrasena. El secreto NUNCA se commitea: vive solo aqui en local y en Coolify.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# Dominios de correo admitidos, separados por comas.
SSO_DOMINIOS=colegioaleman.edu.co
# Rol para quien entra por SSO y no tiene cuenta. Vacio = no se crea ninguna.
SSO_ALTA_AUTOMATICA=
# true = las cuentas del dominio SOLO entran por SSO, nunca con contrasena.
SSO_OBLIGATORIO=false
