* text=auto eol=lf
*.sh text eol=lf
*.sql text eol=lf

# Audio generado con ElevenLabs: se versiona con Git LFS (~100-150 MB en total).
*.mp3 filter=lfs diff=lfs merge=lfs -text
*.ogg filter=lfs diff=lfs merge=lfs -text

# Binarios que no deben tratarse como texto.
*.png binary
*.jpg binary
*.webp binary
*.woff2 binary
